# Generate locally with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
POSTGRES_PASSWORD=
# Optional public browser key passed to the frontend Docker build.
# Empty selects the key-free OpenStreetMap basemap.
VITE_CARTO_BASEMAP_KEY=
# Optional local controls; Compose supplies the database/broker URLs.
AUTO_BOOTSTRAP=false
DEMO_MODE=false
PRODUCTION_MODE=false
# Public production origin(s), or [] for same-origin only. Use JSON arrays.
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional external shared store; Compose supplies Redis in its private network.
SECURITY_REDIS_URL=
RATE_LIMIT_ENABLED=true
API_REQUESTS_PER_MINUTE=600
LOGIN_REQUESTS_PER_MINUTE=20
ACCOUNT_LOGIN_REQUESTS_PER_WINDOW=10
ACCOUNT_LOGIN_WINDOW_SECONDS=900
HEAVY_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=64
MAX_CONCURRENT_HEAVY_REQUESTS=2
MAX_ACTIVE_JOBS_PER_PROJECT=10
