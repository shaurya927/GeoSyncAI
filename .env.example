# Generate locally with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
POSTGRES_PASSWORD=
# Optional public browser key passed to the frontend Docker build.
# Empty selects the key-free OpenStreetMap basemap.
VITE_CARTO_BASEMAP_KEY=
# Optional local controls; Compose supplies the database/broker URLs.
AUTO_BOOTSTRAP=false
DEMO_MODE=false
